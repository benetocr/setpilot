{
  "name": "setpilot-app",
  "version": "0.1.0",
  "private": true,
  "description": "SetPilot: playback companion for Ableton Live",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node host/main.js",
    "test": "node dev/test_engine.js && SP_BRIDGE=1 node dev/test_engine.js && python3 -m unittest discover -s live/tests && node dev/test_setup.js && node dev/e2e.js",
    "test:latency": "SP_BRIDGE=1 SP_WRITE_DELAY=5 node dev/test_engine.js",
    "app": "electron desktop/main.js",
    "dist": "electron-builder --mac zip --arm64 --x64"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "qrcode": "^1.5.4"
  },
  "optionalDependencies": {
    "@julusian/midi": "^3.6.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "productName": "SetPilot",
  "author": "SetPilot",
  "build": {
    "appId": "app.setpilot.desktop",
    "productName": "SetPilot",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "core/**",
      "bridge/**",
      "host/**",
      "live/SetPilot/*.py",
      "live/SetPilot/spec.json",
      "installer/**",
      "desktop/**",
      "package.json",
      "!**/*.log",
      "!desktop/make_icons.js"
    ],
    "extraResources": [
      { "from": "plugin-dist", "to": "plugins", "filter": ["**/*"] },
      { "from": "native-dist", "to": "bin", "filter": ["**/*"] },
      { "from": "assets/pads", "to": "pads", "filter": ["**/*"] }
    ],
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.music",
      "icon": "desktop/assets/icon.png",
      "identity": null,
      "extendInfo": {
        "LSUIElement": true,
        "NSLocalNetworkUsageDescription": "SetPilot shows its dashboard to your phones and tablets on this network.",
        "NSAppleEventsUsageDescription": "SetPilot opens Ableton Live's Export window on your arrangement.",
        "NSBonjourServices": [
          "_http._tcp"
        ]
      }
    },
    "publish": null
  }
}
